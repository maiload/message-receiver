{
  "vhosts": [
    { "name": "/" }
  ],
  "exchanges": [
    {
      "name": "message.exchange",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "message.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false
    }
  ],
  "queues": [
    {
      "name": "message.realtime.queue",
      "vhost": "/",
